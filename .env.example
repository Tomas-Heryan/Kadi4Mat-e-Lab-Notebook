# Copy to ".env" (git-ignored) and fill in. The tool reads this file itself; VS Code's
# Python extension also loads it for the debugger (see .vscode/launch.json).
KADI_URL=https://kadi-test.vsb.cz
# Replace TOKEN with your personal access token (starts with pat_). Never commit this file.
KADI_TOKEN=TOKEN
# Optional: PEM bundle of an internal certificate authority (TLS stays verified).
# KADI_CA_BUNDLE=C:\certs\vsb-internal-ca.pem
# Optional: request timeout in seconds (default 120), state and report folders.
# KADI_TIMEOUT=120
# KADI_STATE_DIR=state
# KADI_REPORT_DIR=reports
